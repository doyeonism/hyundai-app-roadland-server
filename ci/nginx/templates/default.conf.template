# TLS 는 서버 공용 엣지 프록시(Caddy, ci/edge/)가 종료하고 HTTP 로 전달한다.
# 이 nginx 는 호스트 포트를 열지 않으며 edge 네트워크에서만 접근된다.

# ${SERVER_NAME} 이외의 도메인 요청 차단 (엣지 뒤의 방어선)
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${SERVER_NAME} www.${SERVER_NAME};

    # Allow large file uploads
    client_max_body_size 100M;

    # Re-resolve upstream hostnames periodically instead of caching the IP
    # from container start — otherwise a container restart/recreate (new IP)
    # leaves nginx pointing at a dead address until nginx itself is reloaded.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Backend API requests
    location /api/ {
        set $upstream_api http://${PROJECT_NAME}-server:${SERVER_PORT};
        proxy_pass $upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Backend static/uploaded resources
    location /resources/ {
        set $upstream_api http://${PROJECT_NAME}-server:${SERVER_PORT};
        proxy_pass $upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # 로드랜드는 web 을 띄우지 않는다(docker-compose.prod.yaml 참고). 되살릴 때 아래 주석을 푼다.
    location / {
        return 404;
    }

    # # Frontend Web Application (Next.js)
    # location / {
    #     set $upstream_web http://${PROJECT_NAME}-web:${WEB_PORT};
    #     proxy_pass $upstream_web;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "upgrade";
    #     proxy_set_header Host $host;
    #     proxy_cache_bypass $http_upgrade;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    # }
}

